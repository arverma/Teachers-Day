---
import { siteConfig } from "../data/site";
import type { PersonConfig } from "../data/types";
import { createWhatsAppShareUrl } from "../lib/share";

interface Props {
  person: PersonConfig;
}

const { person } = Astro.props;
const whatsappShareUrl = createWhatsAppShareUrl(person);
---

<section class="closing section-shell" data-reveal>
  <div class="closing__thought">
    {siteConfig.closing.map((line) => <p>{line}</p>)}
  </div>
  <p class="closing__occasion">{siteConfig.occasion}</p>
  <a
    id="share-on-whatsapp"
    class="closing__share"
    href={whatsappShareUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share this thank-you note on WhatsApp"
  >
    Share on WhatsApp <span aria-hidden="true">↗</span>
  </a>
</section>

<footer class="site-footer section-shell">
  <p>
    Made with gratitude by {siteConfig.author.name}
    <span aria-hidden="true"> · </span>
    <a href={siteConfig.author.portfolioUrl} rel="me">arverma.dev</a>
  </p>
  <p>{siteConfig.date}</p>
  {siteConfig.privacy.footer && <small>{siteConfig.privacy.footer}</small>}
</footer>
